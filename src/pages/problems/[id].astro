---
import Base from '../../layouts/Base.astro';
import Code from '../../components/Code.astro';
import Diff from '../../components/Diff.astro';
import Section from '../../components/Section.astro';
import {
  concepts,
  getContent,
  historyOf,
  problemCode,
  problems,
  STATUS_COLOR,
} from '../../lib/data';
import { RESULT_LABEL, type ReviewResult } from '../../lib/types';
import { annotateUrl, conceptUrl } from '../../lib/issue';
import { fullDate, href } from '../../lib/url';

export function getStaticPaths() {
  return problems.map((p) => ({ params: { id: p.id }, props: { problem: p } }));
}

const { problem } = Astro.props;
const content = getContent(problem.id);
const history = historyOf(problem.id);
const linked = problem.concepts
  .map((id) => concepts.find((c) => c.id === id))
  .filter((c) => c !== undefined);

/** 오답 코드를 아직 안 채웠으면 비교할 게 없으니 전체 코드만 보여준다 */
const canCompare = content.myCode.length > 0;
const tabs = canCompare
  ? [
      { key: 'split', label: '나란히 보기' },
      { key: 'diff', label: 'Diff 보기' },
      { key: 'full', label: '전체 코드' },
    ]
  : [];

const files = [
  'review.md',
  ...(canCompare ? ['my-code.java'] : []),
  'answer-code.java',
  ...content.attempts.map((a) => `attempts/${a.file}`),
];

const resultColor: Record<ReviewResult, string> = {
  FAILED: 'var(--err)',
  PARTIAL: 'var(--warn)',
  UNDERSTOOD: 'var(--ok)',
};
---

<Base title={problem.title} nav="problems">
  <main class="page page--narrow detail">
    <a class="back" href={href('/problems')}>← Problems</a>

    <header class="head">
      <div>
        <div class="ident">
          <span class="mono code">{problemCode(problem)}</span>
          <span class="mono badge">{problem.difficulty.toUpperCase()}</span>
        </div>
        <h1 class="page-title">{problem.title}</h1>
        <div class="tags">
          {problem.types.map((t) => <span class="tag tag--lg">{t}</span>)}
        </div>
      </div>

      <dl class="meta">
        <dt>첫 풀이</dt>
        <dd class="mono">{fullDate(problem.firstSolvedAt)}</dd>
        <dt>마지막 복습</dt>
        <dd class="mono">{fullDate(problem.lastReviewedAt)}</dd>
        <dt>현재 상태</dt>
        <dd class="mono" style={`color: ${STATUS_COLOR[problem.reviewStatus]}`}>
          {problem.reviewStatus}
        </dd>
      </dl>
    </header>

    <div class="cols">
      <div class="main">
        <Section title="MY APPROACH">
          <div class="card prose">
            {
              content.approach || (
                <span class="todo">
                  아직 기록하지 않았습니다.
                  <a class="write" href={annotateUrl(problem.id)} target="_blank" rel="noopener">
                    오답노트 쓰기 →
                  </a>
                </span>
              )
            }
          </div>
        </Section>

        <section>
          <div class="code-bar">
            <h2 class="section-title">CODE</h2>
            {
              tabs.length > 0 && (
                <div class="tabs">
                  {tabs.map((t, i) => (
                    <button
                      class:list={['tab', { on: i === 0 }]}
                      type="button"
                      data-tab={t.key}
                    >
                      {t.label}
                    </button>
                  ))}
                </div>
              )
            }
          </div>

          {
            canCompare && (
              <>
                <div class="card split" data-pane="split">
                  <Code class="half" code={content.myCode} label="MY CODE" tone="err" />
                  <Code code={content.answerCode} label="ANSWER CODE" tone="ok" />
                </div>

                <div data-pane="diff" hidden>
                  <Diff
                    before={content.myCode}
                    after={content.answerCode}
                    label="DIFF · my-code.java → answer-code.java"
                  />
                </div>
              </>
            )
          }

          <div class="card" data-pane="full" hidden={canCompare}>
            <Code code={content.answerCode} label="answer-code.java" />
          </div>
        </section>

        <Section title="WHY IT WAS WRONG">
          <div class="card">
            {
              problem.mistakes.length > 0 && (
                <div class="mistake-tags">
                  {problem.mistakes.map((m) => (
                    <span class="mono mistake-tag">{m}</span>
                  ))}
                </div>
              )
            }
            {
              content.whyWrong.length ? (
                <ol class="reasons">
                  {content.whyWrong.map((r) => (
                    <li>{r}</li>
                  ))}
                </ol>
              ) : (
                <p class="prose todo">
                  오답 원인을 아직 정리하지 않았습니다.
                  <a class="write" href={annotateUrl(problem.id)} target="_blank" rel="noopener">
                    오답노트 쓰기 →
                  </a>
                </p>
              )
            }
          </div>
        </Section>

        {
          content.attempts.length > 0 && (
            <Section title="RE-SOLVED">
              <div class="attempts">
                {content.attempts.map((a) => (
                  <div class="card">
                    <Code code={a.code} label={`attempts/${a.file}`} />
                  </div>
                ))}
              </div>
            </Section>
          )
        }

        <Section title="REVIEW HISTORY">
          <div class="card timeline">
            {
              history.length ? (
                history.map((h, i) => (
                  <div class="event">
                    <span class="mono when">{fullDate(h.date)}</span>
                    <span class="what">{i === 0 ? '최초 기록' : `${i}차 복습`}</span>
                    <span class="note" style={`color: ${resultColor[h.result]}`}>
                      {h.note || RESULT_LABEL[h.result]}
                    </span>
                  </div>
                ))
              ) : (
                <p class="prose todo">복습 기록이 없습니다.</p>
              )
            }
          </div>
        </Section>
      </div>

      <aside class="side">
        <div class="actions">
          <a class="btn review-cta" href={href(`/reviews/${problem.id}`)}>이 문제 복습하기</a>
          <a class="write-cta" href={annotateUrl(problem.id)} target="_blank" rel="noopener">
            오답노트 {content.approach ? '고치기' : '쓰기'} ↗
          </a>
          <a class="write-cta" href={conceptUrl(problem.id)} target="_blank" rel="noopener">
            배운 개념 추가 ↗
          </a>
        </div>

        {
          linked.length > 0 && (
            <div>
              <h2 class="section-title side-title">NEW CONCEPTS</h2>
              <div class="concept-list">
                {linked.map((c) => (
                  <a class="card concept" href={href(`/concepts/${c.id}`)}>
                    <div class="mono kind">
                      {c.category === 'Java' ? 'JAVA' : 'ALGORITHM'}
                    </div>
                    <div class="mono cname">{c.title}</div>
                    <div class="cdesc">{c.description}</div>
                    {c.code && <pre class="mono csnippet">{c.code}</pre>}
                  </a>
                ))}
              </div>
            </div>
          )
        }

        <div>
          <h2 class="section-title side-title">FILES</h2>
          <div class="card files mono">
            {files.map((f) => <div class="file">{f}</div>)}
          </div>
          <a class="src" href={problem.url} target="_blank" rel="noopener">문제 보기 ↗</a>
        </div>
      </aside>
    </div>
  </main>
</Base>

<script>
  // 세 패널을 모두 렌더해두고 탭으로 보이기만 바꾼다.
  const tabs = [...document.querySelectorAll<HTMLElement>('.tab')];
  const panes = [...document.querySelectorAll<HTMLElement>('[data-pane]')];

  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.classList.toggle('on', t === tab));
      panes.forEach((p) => (p.hidden = p.dataset.pane !== tab.dataset.tab));
    });
  }
</script>

<style>
  .detail {
    max-width: var(--page-w);
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
  }

  .ident {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 14px;
  }

  .code {
    font-size: 13px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .badge {
    font-size: 11px;
    color: var(--ink-3);
    border: 1px solid var(--border);
    padding: 3px 8px;
  }

  .page-title {
    margin-bottom: 18px;
  }

  .tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .tag--lg {
    font-size: 11.5px;
    padding: 4px 9px;
  }

  .meta {
    display: grid;
    grid-template-columns: auto auto;
    gap: 10px 28px;
    margin: 0;
    font-size: 12.5px;
    text-align: right;
  }

  .meta dt {
    color: var(--muted-2);
  }

  .meta dd {
    margin: 0;
  }

  .cols {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 40px;
    padding-top: 36px;
    align-items: start;
  }

  .main {
    display: flex;
    flex-direction: column;
    gap: 36px;
    min-width: 0;
  }

  .prose {
    padding: 24px 26px;
    font-size: 14.5px;
    line-height: 1.8;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .todo {
    color: var(--muted);
    font-size: 13.5px;
  }

  .todo code {
    font-family: var(--mono);
    font-size: 12px;
    background: var(--code-bg);
    padding: 2px 6px;
  }

  /* CODE */
  .code-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .tabs {
    display: flex;
    border: 1px solid var(--border);
  }

  .tab {
    font-family: inherit;
    font-size: 12px;
    padding: 7px 14px;
    cursor: pointer;
    background: var(--surface);
    color: var(--muted);
    border: 0;
    border-left: 1px solid var(--border);
  }

  .tab:first-child {
    border-left: 0;
  }

  .tab.on {
    background: var(--chip-bg);
    color: var(--ink);
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .half {
    border-right: 1px solid var(--border);
  }

  /* WHY IT WAS WRONG */
  .mistake-tags {
    padding: 16px 24px;
    border-bottom: 1px solid var(--border-soft);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .mistake-tag {
    font-size: 11.5px;
    color: var(--err);
    border: 1px solid var(--err-border);
    background: var(--err-bg);
    padding: 4px 9px;
  }

  .reasons {
    margin: 0;
    padding: 22px 24px 24px 44px;
    font-size: 14.5px;
    line-height: 2;
    color: var(--ink-2);
  }

  .attempts {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* REVIEW HISTORY */
  .timeline {
    padding: 6px 26px 22px;
  }

  .event {
    display: grid;
    grid-template-columns: 110px 120px 1fr;
    gap: 20px;
    padding: 18px 0;
    border-bottom: 1px solid var(--border-soft);
    align-items: baseline;
  }

  .event:last-child {
    border-bottom: 0;
  }

  .when {
    font-size: 12.5px;
    color: var(--muted-2);
  }

  .what,
  .note {
    font-size: 13px;
    text-wrap: pretty;
  }

  /* 사이드 */
  .side {
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: sticky;
    top: 88px;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .review-cta {
    text-align: center;
    padding: 16px 20px;
    font-size: 13.5px;
  }

  .write-cta {
    text-align: center;
    padding: 12px 20px;
    font-size: 12.5px;
    color: var(--ink-3);
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .write-cta:hover {
    border-color: var(--faint);
    color: var(--ink);
  }

  .write {
    margin-left: 8px;
    border-bottom: 1px solid var(--faint-3);
    color: var(--ink-3);
    white-space: nowrap;
  }

  .side-title {
    margin-bottom: 14px;
  }

  .concept-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .concept {
    padding: 18px 20px;
    display: block;
  }

  .kind {
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: var(--muted-2);
    margin-bottom: 8px;
  }

  .cname {
    font-size: 15px;
    margin-bottom: 8px;
  }

  .cdesc {
    font-size: 12.5px;
    color: var(--muted);
    line-height: 1.6;
  }

  .csnippet {
    margin-top: 12px;
    background: var(--code-bg);
    padding: 10px 12px;
    font-size: 11px;
    color: var(--ink-3);
    overflow-x: auto;
  }

  .files {
    font-size: 12px;
  }

  .file {
    padding: 12px 18px;
    border-bottom: 1px solid var(--border-soft);
    color: var(--ink-3);
  }

  .file:last-child {
    border-bottom: 0;
  }

  .src {
    display: inline-block;
    margin-top: 14px;
    font-size: 12.5px;
    color: var(--muted);
    border-bottom: 1px solid var(--faint-3);
  }

  @media (max-width: 1000px) {
    .head {
      flex-direction: column;
      gap: 24px;
    }

    .meta {
      text-align: left;
      justify-content: start;
    }

    .cols {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .side {
      position: static;
    }

    .split {
      grid-template-columns: 1fr;
    }

    .half {
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }

    .event {
      grid-template-columns: 100px 1fr;
      gap: 6px 16px;
    }

    .note {
      grid-column: 2;
    }
  }
</style>
