---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { concepts } from '../../lib/data';
import { href } from '../../lib/url';

const sorted = [...concepts].sort(
  (a, b) => a.category.localeCompare(b.category) || a.title.localeCompare(b.title),
);

const categories = [
  { key: 'ALL', label: '전체', count: sorted.length },
  { key: 'Java', label: 'Java', count: sorted.filter((c) => c.category === 'Java').length },
  {
    key: 'Algorithm',
    label: 'Algorithm',
    count: sorted.filter((c) => c.category === 'Algorithm').length,
  },
];
---

<Base title="Concepts" nav="concepts">
  <main class="page">
    <PageHead
      eyebrow="CONCEPTS"
      title="복습 카드"
      note="문제에서 새로 배운 문법과 알고리즘이 쌓입니다"
    />

    {
      sorted.length === 0 ? (
        <div class="card blank">
          <p>아직 기록한 개념이 없습니다.</p>
          <p class="hint">
            문제를 풀며 새로 알게 된 문법이나 알고리즘을 <code>npm run concept</code> 으로
            추가하면 여기에 복습 카드로 쌓입니다.
          </p>
        </div>
      ) : (
        <div class="cols">
          <nav class="cats">
            {categories.map((c, i) => (
              <button class:list={['cat', { on: i === 0 }]} type="button" data-cat={c.key}>
                <span>{c.label}</span>
                <span class="mono num">{c.count}</span>
              </button>
            ))}
          </nav>

          <div class="grid">
            {sorted.map((c) => (
              <a class="card cell" href={href(`/concepts/${c.id}`)} data-category={c.category}>
                <div class="mono cname">{c.title}</div>
                <div class="ckind">{c.category === 'Java' ? 'Java API' : 'Algorithm'}</div>
                <div class="mono cuse">{c.relatedProblems.length} problems</div>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </main>
</Base>

<script>
  const cats = [...document.querySelectorAll<HTMLElement>('.cat')];
  const cells = [...document.querySelectorAll<HTMLElement>('.cell')];

  for (const cat of cats) {
    cat.addEventListener('click', () => {
      const key = cat.dataset.cat!;
      cats.forEach((c) => c.classList.toggle('on', c === cat));
      cells.forEach((cell) => {
        cell.hidden = key !== 'ALL' && cell.dataset.category !== key;
      });
    });
  }
</script>

<style>
  .cols {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 40px;
    align-items: start;
  }

  .cats {
    display: flex;
    flex-direction: column;
    gap: 2px;
    position: sticky;
    top: 88px;
  }

  .cat {
    font-family: inherit;
    padding: 10px 14px;
    font-size: 13px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    background: transparent;
    color: var(--ink-3);
    border: 0;
    text-align: left;
  }

  .cat.on {
    background: var(--chip-bg);
    color: var(--ink);
  }

  .num {
    font-size: 11.5px;
    color: var(--muted-2);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .cell {
    padding: 20px;
    min-height: 132px;
    display: flex;
    flex-direction: column;
  }

  .cell:hover {
    border-color: var(--faint);
  }

  .cname {
    font-size: 13.5px;
    margin-bottom: 8px;
    overflow-wrap: anywhere;
  }

  .ckind {
    font-size: 12px;
    color: var(--muted-2);
  }

  .cuse {
    margin-top: auto;
    font-size: 11.5px;
    color: var(--ink-3);
  }

  .blank {
    padding: 48px 40px;
    text-align: center;
  }

  .blank p {
    margin: 0;
    font-size: 14px;
  }

  .hint {
    margin-top: 12px !important;
    color: var(--muted);
    font-size: 13px !important;
    line-height: 1.9;
  }

  .hint code {
    font-family: var(--mono);
    font-size: 12px;
    background: var(--code-bg);
    padding: 2px 6px;
  }

  @media (max-width: 900px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .cats {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
    }

    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
