---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';

/** Contents 쓰기 권한만 미리 골라둔 토큰 발급 링크 */
const TOKEN_URL =
  'https://github.com/settings/personal-access-tokens/new?name=algo-archive&description=Algorithm%20Archive%20write%20access';
---

<Base title="Settings" nav="dashboard">
  <main class="page page--narrow">
    <PageHead eyebrow="SETTINGS" title="쓰기 권한" />

    <div class="card intro">
      <p>
        이 사이트는 서버가 없는 정적 페이지라, 브라우저에서 기록을 저장하려면 GitHub 에
        <b>내가 맞다</b> 는 것을 증명해야 합니다. 그 수단이 토큰입니다.
      </p>
      <p class="sub">
        토큰은 이 브라우저에만 저장되고 아무 데도 전송되지 않습니다. 기기마다 한 번씩 등록하면
        됩니다.
      </p>
    </div>

    <section class="steps">
      <h2 class="section-title">토큰 만들기</h2>
      <ol class="guide">
        <li>
          <a href={TOKEN_URL} target="_blank" rel="noopener">GitHub 토큰 발급 페이지</a> 를 엽니다.
        </li>
        <li><b>Repository access</b> → <code>Only select repositories</code> → <code>algo-archive</code></li>
        <li><b>Permissions</b> → <code>Repository permissions</code> → <code>Contents</code> 를 <code>Read and write</code> 로</li>
        <li><b>Expiration</b> 은 원하는 기간으로 (만료되면 여기서 새로 등록하면 됩니다)</li>
        <li>맨 아래 <b>Generate token</b> → 만들어진 값을 복사해 아래에 붙여넣기</li>
      </ol>
    </section>

    <section>
      <h2 class="section-title">토큰 등록</h2>
      <div class="card form">
        <input
          class="field mono"
          id="token"
          type="password"
          placeholder="github_pat_..."
          autocomplete="off"
          spellcheck="false"
        />
        <div class="row">
          <button class="btn" type="button" id="save">등록하고 확인</button>
          <button class="btn btn--ghost" type="button" id="clear">삭제</button>
          <span class="status" id="status"></span>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import { checkToken, clearToken, hasToken, setToken } from '../lib/github';

  const field = document.querySelector<HTMLInputElement>('#token')!;
  const status = document.querySelector<HTMLElement>('#status')!;

  function say(message: string, tone: 'ok' | 'err' | 'muted' = 'muted') {
    status.textContent = message;
    status.dataset.tone = tone;
  }

  if (hasToken()) {
    field.placeholder = '등록된 토큰이 있습니다. 바꾸려면 새로 붙여넣으세요.';
    say('등록됨', 'ok');
  }

  document.querySelector('#save')!.addEventListener('click', async () => {
    const value = field.value.trim();
    if (!value) return say('토큰을 붙여넣어주세요.', 'err');

    setToken(value);
    say('확인 중…');

    try {
      const { login, canWrite } = await checkToken();
      if (!canWrite) {
        say('이 레포에 쓸 권한이 없습니다. Contents 를 Read and write 로 주세요.', 'err');
        return;
      }
      field.value = '';
      field.placeholder = '등록된 토큰이 있습니다. 바꾸려면 새로 붙여넣으세요.';
      say(`${login} 으로 연결됐습니다.`, 'ok');
    } catch (error) {
      clearToken();
      say(error instanceof Error ? error.message : String(error), 'err');
    }
  });

  document.querySelector('#clear')!.addEventListener('click', () => {
    clearToken();
    field.value = '';
    field.placeholder = 'github_pat_...';
    say('삭제했습니다.', 'muted');
  });
</script>

<style>
  .intro {
    padding: 24px 26px;
    margin-bottom: 36px;
  }

  .intro p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.8;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .intro .sub {
    margin-top: 12px;
    font-size: 13px;
    color: var(--muted);
  }

  .steps {
    margin-bottom: 36px;
  }

  .section-title {
    margin-bottom: 14px;
  }

  .guide {
    margin: 0;
    padding-left: 22px;
    font-size: 14px;
    line-height: 2.1;
    color: var(--ink-2);
  }

  .guide a {
    border-bottom: 1px solid var(--ink);
  }

  code {
    font-family: var(--mono);
    font-size: 12px;
    background: var(--chip-bg);
    padding: 2px 6px;
  }

  .form {
    padding: 22px 24px;
  }

  .field {
    display: block;
    width: 100%;
    padding: 13px 14px;
    font-size: 13px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--ink);
    border-radius: 0;
  }

  .field:focus {
    outline: 1px solid var(--ink);
  }

  .row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
    flex-wrap: wrap;
  }

  .status {
    font-size: 12.5px;
    color: var(--muted);
  }

  .status[data-tone='ok'] {
    color: var(--ok);
  }

  .status[data-tone='err'] {
    color: var(--err);
  }
</style>
