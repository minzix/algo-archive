---
interface Props {
  /** 제목 위 대문자 모노 라벨 */
  eyebrow: string;
  title: string;
  /** 우측 하단 정렬 보조 문구 */
  note?: string;
}

const { eyebrow, title, note } = Astro.props;
---

<div class="head">
  <div>
    <div class="eyebrow">{eyebrow}</div>
    <h1 class="page-title">{title}</h1>
  </div>
  {note && <p class="note">{note}</p>}
</div>

<style>
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 32px;
  }

  .note {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
    text-align: right;
    line-height: 1.6;
    max-width: 320px;
    text-wrap: pretty;
  }

  @media (max-width: 760px) {
    .head {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .note {
      text-align: left;
    }
  }
</style>
