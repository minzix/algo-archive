---
interface Props {
  /** 대문자 모노 섹션 제목 */
  title: string;
  /** 제목 우측 보조 텍스트 */
  aside?: string;
  /** 제목 색 (WHY IT WAS WRONG 처럼 빨강을 쓰는 경우) */
  tone?: 'default' | 'err';
  class?: string;
}

const { title, aside, tone = 'default', class: className } = Astro.props;
---

<section class:list={['sec', className]}>
  <div class="bar">
    <h2 class="section-title" style={tone === 'err' ? 'color: var(--err)' : undefined}>{title}</h2>
    {aside && <span class="aside">{aside}</span>}
  </div>
  <slot />
</section>

<style>
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 16px;
  }

  .aside {
    font-size: 12px;
    color: var(--muted-2);
  }
</style>
