---
import { heatmap } from '../lib/data';

const weeks = heatmap(26);
---

<div class="heatmap">
  <div class="grid">
    {
      weeks.map((week) => (
        <div class="week">
          {week.days.map((day) => (
            <span
              class="day"
              style={`background: var(--heat-${day.level})`}
              title={`${day.date} · 기록 ${day.count}건`}
            />
          ))}
        </div>
      ))
    }
  </div>

  <div class="legend mono">
    <span>LESS</span>
    {[0, 1, 2, 3, 4].map((l) => <span class="day" style={`background: var(--heat-${l})`} />)}
    <span>MORE</span>
  </div>
</div>

<style>
  .grid {
    display: flex;
    gap: 3px;
    overflow-x: auto;
  }

  .week {
    display: grid;
    grid-template-rows: repeat(7, 1fr);
    gap: 3px;
    flex: none;
  }

  .day {
    width: 11px;
    height: 11px;
    display: block;
  }

  .legend {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 18px;
    font-size: 11px;
    color: var(--muted-2);
  }
</style>
