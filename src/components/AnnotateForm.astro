---
import { MISTAKE_TYPES, type Problem } from '../lib/types';
import type { ProblemContent } from '../lib/data';
import { href } from '../lib/url';

interface Props {
  problem: Problem;
  content: ProblemContent;
}

const { problem, content } = Astro.props;
const isNew = !content.approach && !content.whyWrong.length;
---

<details class="card panel" data-annotate={problem.id} data-settings={href('/settings')}>
  <summary>
    <span class="label">오답노트 {isNew ? '쓰기' : '고치기'}</span>
    <span class="hint">여기서 바로 저장하면 커밋됩니다</span>
  </summary>

  <form class="body">
    <label class="row">
      <span class="name">내 접근</span>
      <textarea name="approach" rows="4" placeholder="처음 문제를 봤을 때 어떤 생각을 했는지"
        >{content.approach}</textarea
      >
    </label>

    <label class="row">
      <span class="name">왜 틀렸는가</span>
      <textarea name="whyWrong" rows="4" placeholder="한 줄에 하나씩"
        >{content.whyWrong.join('\n')}</textarea
      >
    </label>

    <div class="row">
      <span class="name">오답 유형</span>
      <div class="checks">
        {
          MISTAKE_TYPES.map((m) => (
            <label class="check">
              <input type="checkbox" name="mistakes" value={m} checked={problem.mistakes.includes(m)} />
              <span>{m}</span>
            </label>
          ))
        }
      </div>
    </div>

    <div class="row">
      <span class="name">현재 상태</span>
      <div class="checks">
        {
          (['NEEDS_REVIEW', 'UNDERSTOOD'] as const).map((s) => (
            <label class="check">
              <input
                type="radio"
                name="status"
                value={s}
                checked={
                  problem.reviewStatus === s || (problem.reviewStatus === 'UNTOUCHED' && s === 'NEEDS_REVIEW')
                }
              />
              <span class="mono">{s}</span>
            </label>
          ))
        }
      </div>
    </div>

    <label class="row">
      <span class="name">내 오답 코드</span>
      <textarea name="myCode" class="mono code" rows="8" spellcheck="false"
        placeholder="틀렸던 코드를 붙여넣으면 정답 코드와 나란히 비교됩니다">{content.myCode}</textarea
      >
    </label>

    <div class="actions">
      <button class="btn" type="submit">저장</button>
      <span class="status" data-status></span>
    </div>
  </form>
</details>

<script>
  import { saveAnnotation } from '../lib/edit';
  import { hasToken } from '../lib/github';
  import type { MistakeType, ReviewStatus } from '../lib/types';

  for (const panel of document.querySelectorAll<HTMLElement>('[data-annotate]')) {
    const problemId = panel.dataset.annotate!;
    const form = panel.querySelector('form')!;
    const status = panel.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector('button')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!hasToken()) {
        status.dataset.tone = 'err';
        status.innerHTML = `먼저 <a href="${panel.dataset.settings}">설정에서 토큰</a>을 등록해주세요.`;
        return;
      }

      const data = new FormData(form);
      button.disabled = true;
      status.dataset.tone = 'muted';
      status.textContent = '저장 중…';

      try {
        const sha = await saveAnnotation({
          problemId,
          approach: String(data.get('approach') ?? ''),
          whyWrong: String(data.get('whyWrong') ?? ''),
          mistakes: data.getAll('mistakes').map(String) as MistakeType[],
          status: String(data.get('status')) as ReviewStatus,
          myCode: String(data.get('myCode') ?? ''),
        });
        status.dataset.tone = 'ok';
        status.textContent = `저장했습니다 (${sha}). 1~2분 뒤 반영됩니다.`;
      } catch (error) {
        status.dataset.tone = 'err';
        status.textContent = error instanceof Error ? error.message : String(error);
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .panel {
    margin-top: 16px;
  }

  summary {
    padding: 16px 20px;
    cursor: pointer;
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .panel[open] summary {
    border-bottom: 1px solid var(--border);
  }

  .label {
    font-size: 13.5px;
  }

  .hint {
    font-size: 12px;
    color: var(--muted-2);
  }

  .body {
    padding: 22px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .row {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 16px;
    align-items: start;
  }

  .name {
    font-size: 12.5px;
    color: var(--ink-3);
    padding-top: 10px;
  }

  textarea {
    width: 100%;
    padding: 12px 14px;
    font-family: var(--sans);
    font-size: 13.5px;
    line-height: 1.8;
    color: var(--ink-2);
    border: 1px solid var(--border);
    background: var(--bg);
    resize: vertical;
    border-radius: 0;
  }

  textarea:focus {
    outline: 1px solid var(--ink);
  }

  .code {
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.7;
  }

  .checks {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    padding-top: 10px;
  }

  .check {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    cursor: pointer;
  }

  .check input {
    accent-color: var(--ink);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .status {
    font-size: 12.5px;
    color: var(--muted);
  }

  .status[data-tone='ok'] {
    color: var(--ok);
  }

  .status[data-tone='err'] {
    color: var(--err);
  }

  .status :global(a) {
    border-bottom: 1px solid currentColor;
  }

  @media (max-width: 700px) {
    .row {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .name {
      padding-top: 0;
    }

    .checks {
      padding-top: 0;
    }
  }
</style>
